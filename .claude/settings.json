{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "pattern": "go build.*-o\\s+(bin[/\\\\])?cc-console(-cli)?\\.exe",
            "command": "cd ${CLAUDE_PROJECT_DIR:-.} && bash ./build.sh"
          }
        ]
      }
    ]
  }
}
